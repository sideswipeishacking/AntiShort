{
  "manifest_version": 3,
  "name": "AntiShort - Shorts blocker for YouTube",
  "short_name": "AntiShort",
  "version": "1.0.0",
  "description": "Hides YouTube Shorts and opens Shorts links in the regular video player.",
  "homepage_url": "https://github.com/sideswipeishacking/AntiShort",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["declarativeNetRequestWithHostAccess"],
  "host_permissions": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "shorts_redirects",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://youtube.com/*", "*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ]
}
